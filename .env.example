# Inbound free-audit MVP. Set real values in the Vercel Preview dashboard.
# Leave every value empty in git. Do not paste secrets into chat or pull requests.
#
# Keep-alive also reads the existing platform variables already on projeto-x:
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# The admin link uses the request origin, then NEXT_PUBLIC_SITE_URL if origin is empty.

CLIENTS_SUPABASE_URL=
CLIENTS_SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
GEMINI_API_KEY=
GEMINI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
IP_HASH_SECRET=
CRON_SECRET=

# Public self-serve signup is invite-only unless this is exactly "true".
ALLOW_PUBLIC_SIGNUP=

# Shared token for /api/warehouse/pack-confirm (n8n / integrations). Leave empty
# to keep the route closed to unauthenticated callers. Do not commit a value.
WAREHOUSE_PACK_TOKEN=

# Public Google tag IDs. Leave empty to keep GA4, Google Ads, and the consent
# banner off. These are inlined into the browser bundle. Do not put secrets here.
# GA4 measurement ID, for example G-XXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads account ID, for example AW-XXXXXXXX.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion action label. Both the Ads ID and this label are required to send a conversion.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
# Set to exactly true to send normalized email and phone with the Ads conversion after consent.
NEXT_PUBLIC_GOOGLE_ADS_ENHANCED=
